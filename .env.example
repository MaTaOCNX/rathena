# Copy to .env and adjust. Every value is optional; the defaults are shown.

# IP (or hostname) the game client uses to reach the char and map servers.
# 127.0.0.1 only works for a client on this machine; use the LAN/WAN IP otherwise.
PUBLIC_IP=127.0.0.1

# Database
DB_NAME=ragnarok
DB_USER=ragnarok
DB_PASS=ragnarok
DB_ROOT_PASS=ragnarok
# Where MariaDB is published on the host
DB_PUBLISH=127.0.0.1:3306

# Register accounts from the client by logging in as <userid>_M or <userid>_F
NEW_ACCOUNT=yes

# Inter-server account. Leave empty to keep what conf/ says (s1/p1);
# when changed, update the sex='S' row of the `login` table as well.
SERVER_USERID=
SERVER_PASSWD=

TZ=Asia/Bangkok

# Extra ./configure flags, e.g. --enable-prere=yes
CONFIGURE_FLAGS=

# Image registry/namespace and tag used by build, push and pull
REGISTRY=mcr.mataocnx.com/matao-ro
TAG=latest
